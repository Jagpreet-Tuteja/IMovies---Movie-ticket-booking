PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/imovies
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional: SMTP settings for booking emails. Without them, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IMovies <no-reply@imovies.com>"
